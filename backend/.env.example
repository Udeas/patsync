# Copy to .env for local dev. NEVER commit the real .env (it is gitignored).
# On Render, set these in the service's Environment tab instead.

# Required: Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Optional: USPTO module. sqlite/cred paths are local dev paths and must be
# reworked for cloud hosting. Leave unset to run the core API only.
US_PTO_SQLITE_SOURCE=
US_PTO_CRED_DIR=
US_PTO_CALENDAR_ID=
US_PTO_IMAP_HOST=imap.gmail.com
US_PTO_IMAP_USERNAME=
US_PTO_IMAP_PASSWORD=
US_PTO_IMAP_MAILBOX=Tracker_Updates

# App
APP_PORT=8000
DEBUG=false
